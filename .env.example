# Copie ce fichier en .env et remplace les valeurs.
# Ne jamais committer le fichier .env (il est ignoré par Git et Docker).

# Chaîne de connexionPostgreSQL / Neon
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE?ssl=require

# Clé utilisée pour signer les tokens JWT.
# Génère-en une nouvelle avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=remplace-par-une-cle-aleatoire-longue
